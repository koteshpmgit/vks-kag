# Controls what gets uploaded to Cloud Build for the backend image (root
# Dockerfile). frontend is its own build (frontend/Dockerfile, submitted
# separately from ./frontend) and isn't needed here.
frontend
backend/.env
**/*.log
.git
.gcloudignore
README.md
# demo video recording tools: bundled ffmpeg + browser work files (not served)
demo/video Presentations/tools/node_modules
demo/video Presentations/tools/.work
