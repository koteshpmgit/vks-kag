# Copy to .env and adjust
PORT=3000
PGHOST=localhost
PGPORT=5432
PGDATABASE=key_artifact_generator
PGUSER=postgres
PGPASSWORD=postgres

# Login (required) - secret used to sign auth JWTs. Any long random string.
JWT_SECRET=change-me

# SRS document AI extraction (optional) - leave ANTHROPIC_API_KEY unset to run
# without it; the SRS upload step will show a clear error and let the user
# skip extraction and continue manually.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
