server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Nginx's default 1 MB body limit rejects typical SRS PDFs with a 413
    # before they ever reach the backend - keep this >= the backend's multer
    # limit (routes/api.js, 10 MB).
    client_max_body_size 12m;

    # DNS re-resolution for BACKEND_ORIGIN, needed since it's a variable
    # (Cloud Run's *.run.app hostname, or the docker-compose 'backend' service name).
    # Nginx round-robins between listed resolvers (it does NOT fall back), so
    # docker-compose sets NGINX_RESOLVER to Docker's embedded DNS only - with
    # 8.8.8.8 in the list, every other lookup of 'backend' fails with "Host not
    # found". Default (frontend/Dockerfile) keeps both for Cloud Run.
    resolver ${NGINX_RESOLVER} valid=30s;

    # Reverse-proxy the API so the browser always calls same-origin /api/...
    # (matches the React client's relative '/api' base - no CORS/env wiring needed).
    # BACKEND_ORIGIN is a full scheme+host[:port], e.g. http://backend:3001 in
    # docker-compose or https://kag-backend-xxxx.a.run.app on Cloud Run.
    location /api/ {
        set $backend_origin "${BACKEND_ORIGIN}";
        # proxy_pass with a variable target must NOT include a URI part: nginx
        # would then forward that literal URI verbatim (dropping the rest of the
        # request path) instead of doing the usual location-prefix replacement.
        # With no URI part here, the full original request URI (e.g. /api/projects
        # - the backend's Express app is mounted at /api, so it must stay intact)
        # is forwarded unchanged, exactly like the old static proxy_pass did.
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SRS upload waits for Claude's analysis, which can take minutes for a
        # large document - the 60s default cut it off with a 502/504.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Retry once on a transient 502 (e.g. a DNS blip resolving 'backend').
        # Not on 504: a timed-out request may still be running on the backend.
        proxy_intercept_errors on;
        error_page 502 = @api_retry;
    }

    location @api_retry {
        # only replay safe requests - re-sending a POST (e.g. an SRS upload
        # that creates a project) could apply it twice
        if ($request_method != GET) { return 502; }
        set $backend_origin "${BACKEND_ORIGIN}";
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Interactive demo + video presentations, served by the backend (public).
    location /demo/ {
        set $backend_origin "${BACKEND_ORIGIN}";
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
    }
    location = /demo { return 301 /demo/; }

    # SPA fallback so client-side routes (/, /excel, /webapp) work on a hard reload.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be served from browser cache - otherwise a
    # rebuilt image keeps running the old (hash-named) JS bundle until a
    # hard refresh. The hashed files under /assets/ are safe to cache.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
